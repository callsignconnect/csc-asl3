[Unit]
Description=h5t Uvicorn Service
After=network.target

[Service]
User=www-data
Group=www-data
WorkingDirectory=/opt/h5t
Environment="PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
ExecStart=/usr/bin/uvicorn backend:app --host 127.0.0.1 --port 8000 --proxy-headers --log-level debug

# Restart policy for stability
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target

